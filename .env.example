# Copy to .env next to compose.yaml and fill in. Never commit .env.
# Generate each password with: openssl rand -hex 24
# The values below are EXAMPLES; replace them with your own.

# --- Shared ---

# Time zone for container logs (IANA name).
TZ=UTC

# --- PostgreSQL ---

# Superuser created on first start, and the database created for it. Changing these
# later has no effect on an existing data folder.
POSTGRES_USER=app
POSTGRES_PASSWORD=<password-from-openssl-rand-hex-24>
POSTGRES_DB=app

# NAS folder for the data (mounted at /var/lib/postgresql). Create it empty first.
POSTGRES_DATA_NAS_PATH=/volume1/docker/dreambig-nas-backends/postgres

# Host port on the NAS (default 5432).
POSTGRES_HOST_PORT=5432

# Max client connections (default 50). Each one costs memory on a 2 GB NAS.
POSTGRES_MAX_CONNECTIONS=50

# --- Redis ---

# Password every client must send (AUTH). Avoid characters a shell would interpret.
REDIS_PASSWORD=<password-from-openssl-rand-hex-24>

# NAS folder for the data (mounted at /data). Create it empty first.
REDIS_DATA_NAS_PATH=/volume1/docker/dreambig-nas-backends/redis

# Host port on the NAS (default 6379).
REDIS_HOST_PORT=6379

# Memory cap for data (default 128mb; keep well under the container's 256m mem_limit).
REDIS_MAXMEMORY=128mb

# What happens at the cap (default noeviction: writes fail, nothing is lost). Use
# allkeys-lru if Redis is only a cache.
REDIS_MAXMEMORY_POLICY=noeviction

# --- RabbitMQ ---

# Admin user created on first start (the default guest user is then not created).
# Changing these later has no effect on an existing data folder.
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=<password-from-openssl-rand-hex-24>
RABBITMQ_VHOST=/

# NAS folder for the data (mounted at /var/lib/rabbitmq). Create it empty first.
RABBITMQ_DATA_NAS_PATH=/volume1/docker/dreambig-nas-backends/rabbitmq

# Host ports on the NAS: AMQP (default 5672) and management UI (default 15672).
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
